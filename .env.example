# Host folder that becomes your SiYuan workspace (create it before first run).
SIYUAN_WORKSPACE_HOST=./data/workspace

# Published port (host:container uses 6806 inside the image).
SIYUAN_PORT=6806

TZ=Asia/Ho_Chi_Minh
# Rootless Podman: use 0 (maps to your host user). Rootful Docker: your uid/gid, e.g. 1000.
PUID=0
PGID=0

# Required in Docker unless you explicitly bypass (not recommended on a network).
SIYUAN_ACCESS_AUTH_CODE=change-me-to-a-long-random-secret

# Set to true only for trusted local/dev; anyone can access data if auth is bypassed.
SIYUAN_ACCESS_AUTH_CODE_BYPASS=false
